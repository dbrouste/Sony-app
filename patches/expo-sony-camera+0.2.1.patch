+  private fun completeAutoSelection(
+    request: AutoSelectionRequest,
+    measurements: List<StarMeasurement>,
+    scale: Double,
+    cropX: Double,
+    cropY: Double,
+    candidateCount: Int,
+    reason: String?,
+  ) {
+    val found = measurements.isNotEmpty()
+    val selectedStars = measurements.mapIndexed { index, measurement ->
+      mapOf(
+        "id" to index,
+        "x" to ((measurement.x * scale - cropX) / request.viewWidth).coerceIn(0.0, 1.0),
+        "y" to ((measurement.y * scale - cropY) / request.viewHeight).coerceIn(0.0, 1.0),
+        "snr" to measurement.snr,
+        "hfd" to measurement.hfd,
+        "mass" to measurement.mass,
+      )
+    }
+    val primary = selectedStars.firstOrNull()
+    val viewX = primary?.get("x") as? Double ?: 0.0
+    val viewY = primary?.get("y") as? Double ?: 0.0
+    val stillCurrent = synchronized(trackingLock) {
+      if (autoSelectionRequest?.generation != request.generation) {
+        false
+      } else {
+        autoSelectionRequest = null
+        trackingTargets = selectedStars.map { star ->
+          val starX = star["x"] as Double
+          val starY = star["y"] as Double
+          TrackingTarget(
+            id = star["id"] as Int,
+            generation = request.generation,
+            referenceX = starX,
+            referenceY = starY,
+            currentX = starX,
+            currentY = starY,
+            viewWidth = request.viewWidth,
+            viewHeight = request.viewHeight,
+          )
+        }
+        true
+      }
+    }
+    if (!stillCurrent) return
+    sendEvent(
+      "onStarAutoSelected",
+      mapOf(
+        "found" to found,
+        "x" to viewX,
+        "y" to viewY,
+        "candidateCount" to candidateCount,
+        "selectedCount" to selectedStars.size,
+        "stars" to selectedStars,
+        "reason" to reason,
+        "snr" to (measurements.firstOrNull()?.snr ?: 0.0),
+        "hfd" to (measurements.firstOrNull()?.hfd ?: 0.0),
+        "mass" to (measurements.firstOrNull()?.mass ?: 0.0),
+      ),
+    )
+  }
