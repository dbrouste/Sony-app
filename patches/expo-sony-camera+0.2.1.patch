+      4.0 * luminance(bitmap.getPixel(x, y)) +
+        2.0 * luminance(bitmap.getPixel(x - 1, y)) +
+        2.0 * luminance(bitmap.getPixel(x + 1, y)) +
+        2.0 * luminance(bitmap.getPixel(x, y - 1)) +
+        2.0 * luminance(bitmap.getPixel(x, y + 1)) +
+        luminance(bitmap.getPixel(x - 1, y - 1)) +
+        luminance(bitmap.getPixel(x + 1, y - 1)) +
+        luminance(bitmap.getPixel(x - 1, y + 1)) +
+        luminance(bitmap.getPixel(x + 1, y + 1))
+      ) / 16.0
+  }
