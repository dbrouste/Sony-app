+  private fun halfFluxDiameter(samples: List<FluxSample>, centerX: Double, centerY: Double, mass: Double): Double {
+    if (samples.isEmpty() || mass <= 0.0) return 0.0
+    if (samples.size == 1) return 0.5
+    val radialFlux = samples.map { sample ->
+      val radius = kotlin.math.hypot(sample.x - centerX, sample.y - centerY)
+      radius to sample.flux
+    }.sortedBy { it.first }
+    val halfMass = mass / 2.0
+    var accumulated = 0.0
+    var previousRadius = 0.0
+    for ((radius, flux) in radialFlux) {
+      val next = accumulated + flux
+      if (next >= halfMass) {
+        val fraction = if (flux > 0.0) ((halfMass - accumulated) / flux).coerceIn(0.0, 1.0) else 0.0
+        return 2.0 * (previousRadius + (radius - previousRadius) * fraction)
+      }
+      accumulated = next
+      previousRadius = radius
+    }
+    return 2.0 * radialFlux.last().first
+  }
