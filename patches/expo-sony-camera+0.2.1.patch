+  /** Iterative sigma-clipped statistics for a background sample. */
+  private fun robustBackground(values: List<Double>): BackgroundStats? {
+    if (values.size < 10) return null
+    var accepted = values
+    repeat(8) {
+      val mean = accepted.average()
+      val variance = if (accepted.size > 1) {
+        accepted.sumOf { value ->
+          val delta = value - mean
+          delta * delta
+        } / (accepted.size - 1)
+      } else {
+        0.0
+      }
+      val sigma = kotlin.math.sqrt(maxOf(0.0, variance))
+      if (sigma < 0.25) {
+        return BackgroundStats(mean, sigma, accepted.size)
+      }
+      val next = values.filter { value -> kotlin.math.abs(value - mean) <= 2.0 * sigma }
+      if (next.size < 10 || next.size == accepted.size) {
+        return BackgroundStats(mean, sigma, accepted.size)
+      }
+      accepted = next
+    }
+    val mean = accepted.average()
+    val variance = if (accepted.size > 1) {
+      accepted.sumOf { value ->
+        val delta = value - mean
+        delta * delta
+      } / (accepted.size - 1)
+    } else {
+      0.0
+    }
+    return BackgroundStats(mean, kotlin.math.sqrt(maxOf(0.0, variance)), accepted.size)
+  }
