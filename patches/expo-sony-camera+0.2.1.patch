+  private fun trackOneStar(bitmap: Bitmap, target: TrackingTarget): TrackedStar {
+    val width = bitmap.width
+    val height = bitmap.height
+    val scale = maxOf(target.viewWidth / width, target.viewHeight / height)
+    val cropX = (width * scale - target.viewWidth) / 2.0
+    val cropY = (height * scale - target.viewHeight) / 2.0
+    fun viewToImageX(value: Double) =
+      ((value * target.viewWidth + cropX) / scale).coerceIn(0.0, width - 1.0)
+    fun viewToImageY(value: Double) =
+      ((value * target.viewHeight + cropY) / scale).coerceIn(0.0, height - 1.0)
+
+    val centerX = viewToImageX(target.currentX)
+    val centerY = viewToImageY(target.currentY)
+    val imageReferenceX = viewToImageX(target.referenceX)
+    val imageReferenceY = viewToImageY(target.referenceY)
+    // A smaller local window keeps 12-star tracking comfortably below the 200 ms cadence.
+    val radius = maxOf(18, minOf(width, height) / 18)
+    val left = maxOf(0, centerX.toInt() - radius)
+    val right = minOf(width - 1, centerX.toInt() + radius)
+    val top = maxOf(0, centerY.toInt() - radius)
+    val bottom = minOf(height - 1, centerY.toInt() + radius)
+    val coarseBackgroundSamples = mutableListOf<Double>()
+    for (py in top..bottom step 2) {
+      for (px in left..right step 2) {
+        coarseBackgroundSamples.add(luminance(bitmap.getPixel(px, py)))
+      }
+    }
+    val coarseBackground = robustBackground(coarseBackgroundSamples)
+    if (coarseBackground == null) {
+      return TrackedStar(
+        target, null, false, centerX, centerY, imageReferenceX, imageReferenceY,
+        target.currentX, target.currentY,
+      )
+    }
+
+    val attractionSigma = maxOf(7.0, radius / 3.0)
+    var peakX = centerX.toInt()
+    var peakY = centerY.toInt()
+    var smoothedPeak = coarseBackground.mean
+    var peakScore = Double.NEGATIVE_INFINITY
+    for (py in maxOf(1, top)..minOf(height - 2, bottom)) {
+      for (px in maxOf(1, left)..minOf(width - 2, right)) {
+        val candidate = smoothedLuminance(bitmap, px, py)
+        val dx = px - centerX
+        val dy = py - centerY
+        val proximity = kotlin.math.exp(
+          -(dx * dx + dy * dy) / (2.0 * attractionSigma * attractionSigma),
+        )
+        val score = (candidate - coarseBackground.mean) * proximity
+        if (score > peakScore) {
+          peakScore = score
+          smoothedPeak = candidate
+          peakX = px
+          peakY = py
+        }
+      }
+    }
+
+    val measurement = measureStarAtPeak(bitmap, peakX, peakY, smoothedPeak, coarseBackground)
+    val locked = measurement.locked
+    val foundX = if (locked) measurement.x else centerX
+    val foundY = if (locked) measurement.y else centerY
+    val viewX = ((foundX * scale - cropX) / target.viewWidth).coerceIn(0.0, 1.0)
+    val viewY = ((foundY * scale - cropY) / target.viewHeight).coerceIn(0.0, 1.0)
+    return TrackedStar(
+      target, measurement, locked, foundX, foundY, imageReferenceX, imageReferenceY,
+      viewX, viewY,
+    )
+  }
