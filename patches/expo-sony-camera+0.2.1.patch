+  /** Find up to 12 non-saturated, isolated stellar sources away from the image edges. */
+  private fun analyseAutoSelectionFrame(bitmap: Bitmap, request: AutoSelectionRequest) {
+    val width = bitmap.width
+    val height = bitmap.height
+    if (width < 8 || height < 8) return
+    val scale = maxOf(request.viewWidth / width, request.viewHeight / height)
+    val cropX = (width * scale - request.viewWidth) / 2.0
+    val cropY = (height * scale - request.viewHeight) / 2.0
+    // Leave enough room for the centroid aperture and for several seconds of drift.
+    val safetyMargin = maxOf(32, minOf(width, height) / 12)
+    val visibleLeft = maxOf(1, (cropX / scale).toInt() + safetyMargin)
+    val visibleRight = minOf(width - 2, ((request.viewWidth + cropX) / scale).toInt() - safetyMargin)
+    val visibleTop = maxOf(1, (cropY / scale).toInt() + safetyMargin)
+    val visibleBottom = minOf(height - 2, ((request.viewHeight + cropY) / scale).toInt() - safetyMargin)
+    if (visibleRight <= visibleLeft || visibleBottom <= visibleTop) {
+      completeAutoSelection(request, emptyList(), scale, cropX, cropY, 0, "Visible preview is too small.")
+      return
+    }
+
+    val backgroundSamples = mutableListOf<Double>()
+    for (y in visibleTop..visibleBottom step 4) {
+      for (x in visibleLeft..visibleRight step 4) {
+        backgroundSamples.add(luminance(bitmap.getPixel(x, y)))
+      }
+    }
+    val background = robustBackground(backgroundSamples)
+    if (background == null) {
+      completeAutoSelection(request, emptyList(), scale, cropX, cropY, 0, "Unable to measure the image background.")
+      return
+    }
+    val detectionThreshold = background.mean + maxOf(4.0, 4.0 * background.sigma)
+    val scanStep = 2
+    val strongest = mutableListOf<PeakCandidate>()
+    for (y in visibleTop + scanStep..visibleBottom - scanStep step scanStep) {
+      for (x in visibleLeft + scanStep..visibleRight - scanStep step scanStep) {
+        val value = smoothedLuminance(bitmap, x, y)
+        if (value < detectionThreshold) continue
+        var localMaximum = true
+        var strictlyHigher = false
+        loop@ for (dy in -scanStep..scanStep step scanStep) {
+          for (dx in -scanStep..scanStep step scanStep) {
+            if (dx == 0 && dy == 0) continue
+            val neighbour = smoothedLuminance(bitmap, x + dx, y + dy)
+            if (neighbour > value) {
+              localMaximum = false
+              break@loop
+            }
+            if (value > neighbour) strictlyHigher = true
+          }
+        }
+        if (!localMaximum || !strictlyHigher) continue
+        val candidate = PeakCandidate(x, y, value)
+        if (strongest.size < MAX_AUTO_CANDIDATES) {
+          strongest.add(candidate)
+        } else {
+          val weakestIndex = strongest.indices.minByOrNull { strongest[it].value } ?: continue
+          if (value > strongest[weakestIndex].value) strongest[weakestIndex] = candidate
+        }
+      }
+    }
+
+    val separated = mutableListOf<PeakCandidate>()
+    val minimumSeparation = maxOf(16, minOf(width, height) / 40)
+    for (candidate in strongest.sortedByDescending { it.value }) {
+      val overlaps = separated.any { accepted ->
+        kotlin.math.hypot(candidate.x - accepted.x.toDouble(), candidate.y - accepted.y.toDouble()) < minimumSeparation
+      }
+      if (!overlaps) separated.add(candidate)
+      if (separated.size >= MAX_AUTO_STARS_TO_MEASURE) break
+    }
+
+    val measured = mutableListOf<Pair<StarMeasurement, Double>>()
+    for (candidate in separated) {
+      val measurement = measureStarAtPeak(bitmap, candidate.x, candidate.y, candidate.value, background)
+      if (!measurement.locked) continue
+      val score = measurement.snr * kotlin.math.sqrt(maxOf(1.0, measurement.mass))
+      measured.add(measurement to score)
+    }
+    val selected = measured.sortedByDescending { it.second }.take(MAX_TRACKING_STARS).map { it.first }
+    completeAutoSelection(
+      request,
+      selected,
+      scale,
+      cropX,
+      cropY,
+      separated.size,
+      if (selected.isEmpty()) "No suitable unsaturated star was found." else null,
+    )
+  }
