+          "dyPixels" to aggregateDy,
+          "contrast" to (representative?.contrast ?: 0.0),
+          "noise" to (representative?.noise ?: 0.0),
+          "background" to (representative?.background ?: 0.0),
+          "mass" to (representative?.mass ?: 0.0),
